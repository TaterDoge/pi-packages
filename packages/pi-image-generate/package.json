{
  "name": "@taterdoge/pi-image-generate",
  "version": "0.2.0",
  "description": "Skill-driven, user-configurable image generation for Pi with live task status and browser settings.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-skill",
    "pi",
    "image-generation",
    "image-editing"
  ],
  "files": [
    "src",
    "skills",
    "web/dist",
    "assets/preview.png",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "homepage": "https://github.com/TaterDoge/pi-packages/tree/main/packages/pi-image-generate#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TaterDoge/pi-packages.git",
    "directory": "packages/pi-image-generate"
  },
  "bugs": {
    "url": "https://github.com/TaterDoge/pi-packages/issues"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "image": "https://raw.githubusercontent.com/TaterDoge/pi-packages/main/packages/pi-image-generate/assets/preview.png"
  },
  "scripts": {
    "build:web": "vite build",
    "dev:web": "vite build --watch",
    "check": "tsc --noEmit && biome check .",
    "test": "bun test test",
    "prepack": "bun run build:web"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "^0.76.0",
