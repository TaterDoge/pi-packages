{
  "name": "pi-packages",
  "version": "0.1.0",
  "private": true,
  "description": "Bun monorepo for developing Pi extension packages.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "format": "biome format --write .",
    "lint": "biome lint .",
    "biome:check": "biome check .",
    "check:boundaries": "node ./scripts/check-extension-boundaries.mjs",
    "typecheck": "tsc --noEmit",
    "check": "bun run biome:check && bun run check:boundaries && bun run typecheck",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@changesets/cli": "^2.31.0",
    "@types/node": "^24.12.4",
    "typescript": "^5.9.3"
  }
}
