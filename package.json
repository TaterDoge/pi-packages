{
  "name": "pi-packages",
  "version": "0.1.0",
  "private": true,
  "description": "Bun monorepo for developing Pi extension packages.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "format": "biome format --write .",
    "lint": "biome lint .",
    "biome:check": "biome check .",
    "check:boundaries": "node ./scripts/check-extension-boundaries.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/ui && tsc --noEmit -p apps/pi-image-generate && tsc --noEmit -p apps/pi-status",
    "check": "bun run biome:check && bun run check:boundaries && bun run typecheck && bun run build:web",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish",
    "build:web": "bun run --filter \"@taterdoge/*\" build:web"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@biomejs/biome": "^2.4.14",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.62.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  }
}
